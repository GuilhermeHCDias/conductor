        "message": "<ContextMenuItem> doesn't accept that prop. Declared props: id, label, icon, shortcut, type, mono, disabled, destructive, ai, submenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContextMenuItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:item|separator|label)$/]",
        "message": "<ContextMenuItem> type must be one of 'item' | 'separator' | 'label'."
